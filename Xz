async def price_loop():
    while True: await prices.fetch(); await asyncio.sleep(30)

async def liquidation_loop():
    while True:
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            pos = await db.execute("SELECT * FROM positions WHERE status='open'"); pos = await pos.fetchall()
            for p in pos:
                p = dict(p); cur = prices.get(p['symbol']); liq = p['liq']; side = p['side']
                if (side=='long' and cur<=liq) or (side=='short' and cur>=liq):
                    await db.execute("UPDATE positions SET status='liquidated',pnl=? WHERE id=?",(-p['margin'],p['id']))
                    await db.execute("UPDATE users SET daily_noliq=0 WHERE tid=?",(p['tid'],))
                    await give_ach(db,p['tid'],"liquidated")
                    try: await bot.send_message(p['tid'],f"💀 <b>ЛИКВИДАЦИЯ!</b>\n\n{p['symbol']} {side} {p['leverage']}x\nПотеря: {p['margin']:.8f} BTC")
                    except: pass
            await db.commit()
        await asyncio.sleep(10)

