class CryptoPrices:
    def __init__(self):
        self.prices = {
            "BTC": 65432.10,
            "ETH": 3456.78,
            "LTC": 89.34,
            "DOGE": 0.1234,
            "PEPE": 0.00000789,
            "SHIB": 0.00002345,
            "BONK": 0.00000123,
            "SOL": 145.67,
            "XRP": 0.5678,
        }
        self.changes = {k: 0.0 for k in self.prices}
        self.events = []
        self.last_fetch = time.time()
    
    async def fetch_real_prices(self):
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(
                    "https://api.binance.com/api/v3/ticker/price"
                ) as resp:
                    if resp.status == 200:
                        data = await resp.json()
                        for item in data:
                            symbol = item['symbol']
                            if symbol == "BTCUSDT":
                                self.prices["BTC"] = float(item['price'])
                            elif symbol == "ETHUSDT":
                                self.prices["ETH"] = float(item['price'])
                            elif symbol == "LTCUSDT":
                                self.prices["LTC"] = float(item['price'])
                            elif symbol == "DOGEUSDT":
                                self.prices["DOGE"] = float(item['price'])
                            elif symbol == "SOLUSDT":
                                self.prices["SOL"] = float(item['price'])
                            elif symbol == "XRPUSDT":
                                self.prices["XRP"] = float(item['price'])
                        
                        for k in self.prices:
                            self.changes[k] = random.uniform(-5, 5)
                        
                        self.last_fetch = time.time()
        except Exception as e:
            print(f"Ошибка получения цен: {e}")
            self.simulate_prices()
    
    def simulate_prices(self):
        for k in self.prices:
            change = random.uniform(-0.5, 0.5)
            self.prices[k] *= (1 + change / 100)
            self.changes[k] = change
    
    def get_price(self, symbol: str) -> float:
        return self.prices.get(symbol, 0.0)
    
    def get_change(self, symbol: str) -> float:
        return self.changes.get(symbol, 0.0)
    
