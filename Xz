                ("🔴 SHIB сжигает триллионы!", "SHIB"),
                ("🟢 SOLana без сбоев 24 часа!", "SOL"),
            ]
            self.events.append(random.choice(events_list))
            if len(self.events) > 10:
                self.events.pop(0)

    def get_price(self, symbol: str) -> float:
