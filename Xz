def get_rank(btc_val):
    if btc_val >= 100: return "Деген"
    if btc_val >= 10: return "Мегакит"
    if btc_val >= 1: return "Кит"
    if btc_val >= 0.1: return "Майнер"
    if btc_val >= 0.01: return "Барыга"
    if btc_val >= 0.001: return "Нищий"
    return "Бомж"

RANK_EMOJI = {
    "Бомж": "🟤", "Нищий": "⚪", "Барыга": "🟢",
    "Майнер": "🔵", "Кит": "🟣", "Мегакит": "🟡", "Деген": "🔴"
}

async def get_user(db, uid):
    u = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (uid,))
    u = await u.fetchone()
    if not u:
        ref = secrets.token_hex(4).upper()
        await db.execute(
            "INSERT INTO users (telegram_id, ref_code) VALUES (?, ?)", (uid, ref)
        )
        await db.execute("INSERT OR IGNORE INTO bp (user_id) VALUES (?)", (uid,))
        await db.commit()
        u = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (uid,))
        u = await u.fetchone()
    return dict(u)

def btc_value(u):
    btc_price = prices.get_price("BTC")
    if btc_price == 0: btc_price = 1
    hold = u['btc'] + u['balance_sat'] / 1e8
    for coin in ['eth', 'ltc', 'doge', 'sol', 'xrp']:
        hold += u[coin] * prices.get_price(coin.upper()) / btc_price
    for coin in ['pepe', 'shib', 'bonk']:
        hold += u[coin] * prices.get_price(coin.upper()) / btc_price
    return hold

