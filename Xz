@app.post("/api/business/buy_shares")
async def api_buy_shares(request: Request):
    body = await request.json()
    user_id = body.get('user_id')
    business_id = body.get('business_id')
    shares = int(body.get('shares', 0))
    
    if shares <= 0:
        return JSONResponse({"error": "Количество акций > 0"}, 400)
    
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        biz = await db.execute("SELECT * FROM businesses WHERE id = ?", (business_id,))
        biz = await biz.fetchone()
        if not biz:
            return JSONResponse({"error": "Бизнес не найден"}, 404)
        
        biz_dict = dict(biz)
        if biz_dict['available_shares'] < shares:
            return JSONResponse({"error": "Недостаточно акций"}, 400)
        
        price_per_share = calculate_share_price(biz_dict)
        total_cost_btc = price_per_share * shares
        
        user = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (user_id,))
        user = await user.fetchone()
        user_dict = dict(user)
        
        if user_dict['btc'] < total_cost_btc:
            return JSONResponse({"error": f"Нужно {total_cost_btc:.8f} BTC"}, 400)
        
        await db.execute(
            "UPDATE users SET btc = btc - ? WHERE telegram_id = ?",
            (total_cost_btc, user_id)
        )
        
        await db.execute(
            "UPDATE businesses SET available_shares = available_shares - ?, current_price = ? WHERE id = ?",
            (shares, price_per_share, business_id)
        )
        
        existing = await db.execute(
            "SELECT shares FROM business_shares WHERE holder_id = ? AND business_id = ?",
            (user_id, business_id)
        )
        existing = await existing.fetchone()
        if existing:
            await db.execute(
                "UPDATE business_shares SET shares = shares + ?, total_spent = total_spent + ? WHERE holder_id = ? AND business_id = ?",
                (shares, total_cost_btc, user_id, business_id)
            )
        else:
            await db.execute(
                "INSERT INTO business_shares (holder_id, business_id, shares, total_spent) VALUES (?, ?, ?, ?)",
                (user_id, business_id, shares, total_cost_btc)
            )
        
        owner_earnings = total_cost_btc * 0.9
        await db.execute(
            "UPDATE users SET btc = btc + ? WHERE telegram_id = ?",
            (owner_earnings, biz_dict['owner_id'])
        )
        
        total_held = await db.execute(
            "SELECT SUM(shares) as total FROM business_shares WHERE business_id = ?",
            (business_id,)
        )
        total_held = await total_held.fetchone()
        
        if total_held and total_held[0] >= biz_dict['total_shares'] * 0.51:
            current_owner = biz_dict['owner_id']
            holder_id = user_id
            if current_owner != holder_id:
                current_owner_shares = await db.execute(
                    "SELECT shares FROM business_shares WHERE holder_id = ? AND business_id = ?",
                    (current_owner, business_id)
                )
                current_owner_shares = await current_owner_shares.fetchone()
                
                if not current_owner_shares or current_owner_shares[0] < biz_dict['total_shares'] * 0.5:
                    compensation = biz_dict['total_shares'] * price_per_share * 0.5
                    await db.execute(
                        "UPDATE users SET btc = btc + ? WHERE telegram_id = ?",
                        (compensation, current_owner)
                    )
                    
                    await db.execute(
                        "UPDATE businesses SET owner_id = ? WHERE id = ?",
                        (holder_id, business_id)
                    )
                    
                    await db.execute(
                        "DELETE FROM business_shares WHERE holder_id = ? AND business_id = ?",
                        (current_owner, business_id)
                    )
        
        await db.commit()
    
    return {"success": True, "price_per_share": price_per_share, "total_cost": total_cost_btc}

