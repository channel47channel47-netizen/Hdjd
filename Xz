async def get_user_or_create(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        user = await db.execute(
            "SELECT * FROM users WHERE telegram_id = ?", 
            (user_id,)
        )
        user = await user.fetchone()
        if not user:
            await db.execute(
                "INSERT INTO users (telegram_id, referral_code) VALUES (?, ?)",
                (user_id, secrets.token_hex(4).upper())
            )
            await db.execute(
                "INSERT OR IGNORE INTO battle_pass (user_id) VALUES (?)",
                (user_id,)
            )
            await db.commit()
            user = await db.execute(
                "SELECT * FROM users WHERE telegram_id = ?", 
                (user_id,)
            )
            user = await user.fetchone()
        return dict(user)

def verify_telegram_auth(auth_data: str) -> Optional[int]:
    try:
        data = json.loads(auth_data)
        user_id = int(data.get('id', 0))
        if user_id > 0:
            return user_id
    except:
        pass
    return None

