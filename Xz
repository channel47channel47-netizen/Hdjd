def calculate_btc_value(sat_balance, holdings, btc_price):
    total = sat_balance / 1e8
    for symbol, amount in holdings.items():
        if symbol in prices.prices:
            total += amount * prices.get_price(symbol) / btc_price
    return total

def get_rank(btc_value):
    current_rank = "Бомж"
    for name, threshold in RANK_THRESHOLDS:
        if btc_value >= threshold:
            current_rank = name
    return current_rank

def calculate_mining_income(hashrate, btc_price):
    return hashrate * (1.0 / btc_price) / 3600.0

def calculate_business_income(business, owner_rank):
    base = business['total_shares'] * business['income_per_share']
    bonus = RANK_BONUSES.get(owner_rank, {}).get('trading', 1.0)
    ceo_bonus = 1 + business['ceo_level'] * 0.1
    marketing_bonus = 1 + business['marketing_level'] * 0.15
    return base * bonus * ceo_bonus * marketing_bonus

def calculate_share_price(business):
    sold = business['total_shares'] - business['available_shares']
    if sold == 0:
        return business['base_price']
    return business['base_price'] * (1 + sold / 1000) ** 2

