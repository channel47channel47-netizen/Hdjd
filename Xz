async def get_user(db, uid):
    u = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (uid,))
    u = await u.fetchone()
    if not u:
        ref = secrets.token_hex(4).upper()
        await db.execute("INSERT INTO users (telegram_id, ref_code) VALUES (?, ?)", (uid, ref))
        await db.execute("INSERT OR IGNORE INTO bp (user_id) VALUES (?)", (uid,))
        await db.commit()
        u = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (uid,))
        u = await u.fetchone()
    return dict(u)

def btc_value(u):
    bp = prices.get_price("BTC") or 1
    val = u['btc'] + u['balance_sat'] / 1e8
    for c in ['eth','ltc','doge','sol','xrp','pepe','shib','bonk']:
        val += u[c] * prices.get_price(c.upper()) / bp
    return val

async def check_achievement(db, uid, ach_id):
