@app.post("/api/tap")
async def api_tap(request: Request):
    body = await request.json()
    user_id = body.get('user_id', 0)
    taps = body.get('taps', 1)
    
    if user_id == 0:
        return JSONResponse({"error": "Unauthorized"}, 401)
    
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        user = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (user_id,))
        user = await user.fetchone()
        
        if not user:
            return JSONResponse({"error": "User not found"}, 404)
        
        user_dict = dict(user)
        btc_value = calculate_btc_value(
            user_dict['balance_sat'],
            {k: user_dict[k] for k in ['btc','eth','ltc','doge','pepe','shib','bonk','sol','xrp']},
            prices.get_price("BTC")
        )
        rank = get_rank(btc_value)
        rank_bonus = RANK_BONUSES.get(rank, RANK_BONUSES["Бомж"])
        
        total_reward = 0
        for _ in range(taps):
            reward = TAP_BASE_REWARD * user_dict['tap_power'] * rank_bonus['tap']
            if user_dict['multi_tap_level'] > 0:
                reward *= (1 + user_dict['multi_tap_level'] * 0.25)
            total_reward += reward
        
        new_balance = user_dict['balance_sat'] + total_reward
        new_taps = user_dict['total_taps'] + taps
        
        await db.execute(
            "UPDATE users SET balance_sat = ?, total_taps = ? WHERE telegram_id = ?",
            (new_balance, new_taps, user_id)
        )
        
        await add_battle_pass_xp(db, user_id, taps * 0.1)
        await db.commit()
    
    return {
        "reward": total_reward,
        "new_balance": new_balance,
        "total_taps": new_taps,
        "rank": rank,
    }

async def add_battle_pass_xp(db, user_id, xp):
    await db.execute(
        "UPDATE battle_pass SET xp = xp + ? WHERE user_id = ?",
        (xp, user_id)
    )
    bp = await db.execute(
        "SELECT level, xp FROM battle_pass WHERE user_id = ?",
        (user_id,)
    )
    bp = await bp.fetchone()
    if bp:
        xp_needed = bp['level'] * 1000
        if bp['xp'] >= xp_needed:
            new_level = bp['level'] + 1
            await db.execute(
                "UPDATE battle_pass SET level = ?, xp = xp - ? WHERE user_id = ?",
                (new_level, xp_needed, user_id)
            )

@app.post("/api/trade")
async def api_trade(request: Request):
    body = await request.json()
    user_id = body.get('user_id')
    symbol = body.get('symbol', 'BTC')
    action = body.get('action', 'buy')
    amount = float(body.get('amount', 0))
    
    if amount <= 0:
        return JSONResponse({"error": "Неверная сумма"}, 400)
    
    price = prices.get_price(symbol)
    if price == 0:
        return JSONResponse({"error": "Неизвестный символ"}, 400)
    
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        user = await db.execute("SELECT * FROM users WHERE telegram_id = ?", (user_id,))
        user = await user.fetchone()
        if not user:
            return JSONResponse({"error": "User not found"}, 404)
        
        user_dict = dict(user)
        cost = amount * price / prices.get_price("BTC")
        
        if action == 'buy':
            cost_btc = cost
            if user_dict['btc'] < cost_btc:
                return JSONResponse({"error": "Недостаточно BTC"}, 400)
            
            new_btc = user_dict['btc'] - cost_btc
            col = symbol.lower()
            new_hold = user_dict.get(col, 0) + amount
            
            await db.execute(
                f"UPDATE users SET btc = ?, {col} = ? WHERE telegram_id = ?",
                (new_btc, new_hold, user_id)
            )
        else:
            col = symbol.lower()
            if user_dict.get(col, 0) < amount:
                return JSONResponse({"error": f"Недостаточно {symbol}"}, 400)
            
            btc_gain = cost
            new_btc = user_dict['btc'] + btc_gain
            new_hold = user_dict[col] - amount
            
            await db.execute(
                f"UPDATE users SET btc = ?, {col} = ? WHERE telegram_id = ?",
                (new_btc, new_hold, user_id)
            )
        
        await db.execute(
            "INSERT INTO trades (user_id, symbol, side, amount, price) VALUES (?, ?, ?, ?, ?)",
            (user_id, symbol, action, amount, price)
        )
        await db.commit()
    
    return {"success": True, "price": price, "cost_btc": cost}

