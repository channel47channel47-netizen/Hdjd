@dp.callback_query(F.data == "wheel")
async def wheel(callback: CallbackQuery):
    uid = callback.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        u = await get_user(db, uid)
        now = time.time()
        
        if now - u['wheel_time'] < 43200:
            rem = 43200 - (now - u['wheel_time'])
            hrs = int(rem//3600)
            mins = int((rem%3600)//60)
            await callback.answer(f"Доступно через {hrs}ч {mins}мин", show_alert=True)
            return
        
        prizes = [("100 сат",100,"sat",30),("500 сат",500,"sat",25),("1000 сат",1000,"sat",15),
                  ("0.0001 BTC",0.0001,"btc",10),("x2 тапы 1ч",0,"boost",8),("x2 майнинг 30м",0,"boost2",5),
                  ("0.001 BTC",0.001,"btc",2),("Пустышка 💨",0,"none",5)]
        
        r = random.randint(1, sum(p[3] for p in prizes))
        cum = 0
        prize = prizes[0]
        for p in prizes:
            cum += p[3]
            if r <= cum: prize = p; break
        
        if prize[2] == "sat":
            await db.execute("UPDATE users SET sat = sat + ?, wheel_time = ? WHERE tid = ?", (prize[1], now, uid))
        elif prize[2] == "btc":
            await db.execute("UPDATE users SET btc = btc + ?, wheel_time = ? WHERE tid = ?", (prize[1], now, uid))
        else:
            await db.execute("UPDATE users SET wheel_time = ? WHERE tid = ?", (now, uid))
        await db.commit()
    
    await callback.message.edit_text(f"<b>🎡 КОЛЕСО ФОРТУНЫ</b>\n\n🎰 Крутим...\n\n✨ Выпало: <b>{prize[0]}</b>!\n\n<i>Следующий раз через 12ч</i>", reply_markup=back_btn())

