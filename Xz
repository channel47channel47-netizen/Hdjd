class CryptoPrices:
    def __init__(self):
        self.prices = {
            "BTC": 65000, "ETH": 3400, "LTC": 85, "DOGE": 0.12,
            "SOL": 140, "XRP": 0.55, "PEPE": 0.000007,
            "SHIB": 0.00002, "BONK": 0.000001,
        }
        self.changes = {k: 0.0 for k in self.prices}
        self.events = []
        self.last_fetch = 0

    async def fetch_real_prices(self):
        if time.time() - self.last_fetch < 30: return
        symbols_map = {"BTC":"BTCUSDT","ETH":"ETHUSDT","LTC":"LTCUSDT","DOGE":"DOGEUSDT","SOL":"SOLUSDT","XRP":"XRPUSDT"}
        try:
            async with aiohttp.ClientSession() as session:
                for coin, symbol in symbols_map.items():
                    try:
                        async with session.get(f"https://api.binance.com/api/v3/ticker/price?symbol={symbol}",timeout=aiohttp.ClientTimeout(total=5)) as resp:
                            if resp.status == 200:
                                data = await resp.json()
                                old = self.prices.get(coin, float(data['price']))
                                new = float(data['price'])
                                self.changes[coin] = ((new - old) / old) * 100 if old > 0 else 0
                                self.prices[coin] = new
                    except: pass
                try:
                    async with session.get("https://api.coingecko.com/api/v3/simple/price?ids=pepe,shiba-inu,bonk&vs_currencies=usd",timeout=aiohttp.ClientTimeout(total=5)) as resp:
                        if resp.status == 200:
                            data = await resp.json()
                            for coin, key in [("PEPE","pepe"),("SHIB","shiba-inu"),("BONK","bonk")]:
                                if key in data:
                                    old = self.prices.get(coin, data[key]['usd'])
                                    new = data[key]['usd']
                                    self.changes[coin] = ((new - old) / old) * 100 if old > 0 else 0
                                    self.prices[coin] = new
                except: pass
            self.last_fetch = time.time()
        except: pass

