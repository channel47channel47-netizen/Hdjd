async def update_prices_loop():
    while True:
        await prices.fetch_real_prices()
        prices.generate_event()
        
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            
            positions = await db.execute(
                "SELECT * FROM positions WHERE status = 'open'"
            )
            positions = await positions.fetchall()
            
            for p in positions:
                p_dict = dict(p)
                current_price = prices.get_price(p_dict['symbol'])
                side = p_dict['side']
                liq_price = p_dict['liquidation_price']
                
                is_liquidated = (
                    (side == 'long' and current_price <= liq_price) or
                    (side == 'short' and current_price >= liq_price)
                )
                
                if is_liquidated:
                    await db.execute(
                        """UPDATE positions SET 
                        status = 'liquidated', closed_at = CURRENT_TIMESTAMP, pnl = ?
                        WHERE id = ?""",
                        (-p_dict['margin'], p_dict['id'])
                    )
            
            await db.commit()
        
        await asyncio.sleep(5)

async def mining_loop():
    while True:
        async with aiosqlite.connect(DB_PATH) as db:
            users = await db.execute(
                "SELECT telegram_id, mining_hashrate, balance_sat, last_mine_time FROM users WHERE mining_hashrate > 0"
            )
            users = await users.fetchall()
            now = time.time()
            btc_price = prices.get_price("BTC")
            
            for u in users:
                elapsed = now - u[3] if u[3] > 0 else 0
                if elapsed >= 1.0:
                    income = calculate_mining_income(u[1], btc_price) * elapsed
                    await db.execute(
                        "UPDATE users SET balance_sat = balance_sat + ?, last_mine_time = ? WHERE telegram_id = ?",
                        (income, now, u[0])
                    )
            await db.commit()
        
        await asyncio.sleep(1)

async def business_income_loop():
    while True:
        async with aiosqlite.connect(DB_PATH) as db:
            db.row_factory = aiosqlite.Row
            businesses = await db.execute("SELECT * FROM businesses")
            businesses = await businesses.fetchall()
            
            now = time.time()
            for b in businesses:
                b_dict = dict(b)
                if now - b_dict['last_income_time'] >= 3600:
                    owner = await db.execute(
                        "SELECT * FROM users WHERE telegram_id = ?",
                        (b_dict['owner_id'],)
                    )
                    owner = await owner.fetchone()
                    if owner:
                        owner_dict = dict(owner)
                        btc_value = calculate_btc_value(
                            owner_dict['balance_sat'],
                            {k: owner_dict[k] for k in ['btc','eth','ltc','doge','pepe','shib','bonk','sol','xrp']},
                            prices.get_price("BTC")
                        )
                        rank = get_rank(btc_value)
                        income = calculate_business_income(b_dict, rank)
                        
                        await db.execute(
                            "UPDATE users SET balance_sat = balance_sat + ? WHERE telegram_id = ?",
                            (income, b_dict['owner_id'])
                        )
                        await db.execute(
                            "UPDATE businesses SET total_income = total_income + ?, last_income_time = ? WHERE id = ?",
                            (income, now, b_dict['id'])
                        )
                        
                        holders = await db.execute(
                            "SELECT * FROM business_shares WHERE business_id = ?",
                            (b_dict['id'],)
                        )
                        holders = await holders.fetchall()
                        for h in holders:
                            dividend = income * (h[2] / b_dict['total_shares']) * 0.3
                            await db.execute(
                                "UPDATE users SET balance_sat = balance_sat + ? WHERE telegram_id = ?",
                                (dividend, h[0])
                            )
            await db.commit()
        
        await asyncio.sleep(3600)

