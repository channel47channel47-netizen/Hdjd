def calc_rank(v):
    if v>=100: return "Деген"
    if v>=10: return "Мегакит"
    if v>=1: return "Кит"
    if v>=0.1: return "Майнер"
    if v>=0.01: return "Барыга"
    if v>=0.001: return "Нищий"
    return "Бомж"

