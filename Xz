@dp.callback_query(F.data == "wheel")
async def cmd_wheel(callback: CallbackQuery):
    uid = callback.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        u = await get_user(db, uid)
        now = time.time()
        if now - u['daily_wheel'] < 43200:
            remaining = 43200 - (now - u['daily_wheel'])
            hrs = int(remaining // 3600)
            mins = int((remaining % 3600) // 60)
            await callback.answer(f"Колесо доступно через {hrs}ч {mins}мин", show_alert=True); return
        
        prizes = [("100 сат", 100, 30), ("500 сат", 500, 25), ("1000 сат", 1000, 15),
                  ("0.0001 BTC", 0.0001, 10), ("x2 тапы 1ч", 0, 8), ("x2 майнинг 30м", 0, 5),
                  ("0.001 BTC", 0.001, 2), ("Пустышка 💨", 0, 5)]
        
        total = sum(p[2] for p in prizes)
        r = random.randint(1, total)
        cum = 0
        prize = prizes[0]
        for p in prizes:
            cum += p[2]
            if r <= cum: prize = p; break
        
        if prize[0] == "0.0001 BTC": await db.execute("UPDATE users SET btc=btc+?, daily_wheel=? WHERE telegram_id=?", (prize[1], now, uid))
        elif prize[0] == "0.001 BTC": await db.execute("UPDATE users SET btc=btc+?, daily_wheel=? WHERE telegram_id=?", (prize[1], now, uid))
        elif prize[1] > 0: await db.execute("UPDATE users SET balance_sat=balance_sat+?, daily_wheel=? WHERE telegram_id=?", (prize[1], now, uid))
        else: await db.execute("UPDATE users SET daily_wheel=? WHERE telegram_id=?", (now, uid))
        await db.commit()
    
    await callback.message.edit_text(f"<b>🎡 КОЛЕСО ФОРТУНЫ</b>\n\n🎰 Крутим...\n\n✨ Выпало: <b>{prize[0]}</b>!\n\n<i>Следующий раз через 12 часов</i>", reply_markup=back_kb())

