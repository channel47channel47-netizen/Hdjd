@app.post("/api/trade/close")
async def api_close_futures(request: Request):
    body = await request.json()
    user_id = body.get('user_id')
    position_id = body.get('position_id')
    
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        pos = await db.execute(
            "SELECT * FROM positions WHERE id = ? AND user_id = ? AND status = 'open'",
            (position_id, user_id)
        )
        pos = await pos.fetchone()
        if not pos:
            return JSONResponse({"error": "Позиция не найдена"}, 404)
        
        pos_dict = dict(pos)
        current_price = prices.get_price(pos_dict['symbol'])
        entry = pos_dict['entry_price']
        amount = pos_dict['amount']
        leverage = pos_dict['leverage']
        side = pos_dict['side']
        margin = pos_dict['margin']
        
        if side == 'long':
            pnl_pct = (current_price - entry) / entry * leverage * 100
            pnl_btc = margin * (current_price - entry) / entry * leverage
        else:
            pnl_pct = (entry - current_price) / entry * leverage * 100
            pnl_btc = margin * (entry - current_price) / entry * leverage
        
        new_btc = margin + pnl_btc
        if new_btc < 0:
            new_btc = 0
        
        await db.execute(
            "UPDATE users SET btc = btc + ? WHERE telegram_id = ?",
            (new_btc, user_id)
        )
        
        await db.execute(
            """UPDATE positions SET 
            status = 'closed', closed_at = CURRENT_TIMESTAMP, pnl = ? 
            WHERE id = ?""",
            (pnl_btc, position_id)
        )
        await db.commit()
    
    return {
        "success": True,
        "pnl_btc": pnl_btc,
        "pnl_pct": pnl_pct,
        "was_liquidated": new_btc == 0,
    }

