async def get_user(db, uid):
    u = await db.execute("SELECT * FROM users WHERE tid=?",(uid,))
    u = await u.fetchone()
    if not u:
        ref = secrets.token_hex(4).upper()
        await db.execute("INSERT INTO users (tid,ref_code,sat) VALUES (?,?,0)",(uid,ref))
        await db.execute("INSERT OR IGNORE INTO bp (tid) VALUES (?)",(uid,))
        await db.commit()
        u = await db.execute("SELECT * FROM users WHERE tid=?",(uid,))
        u = await u.fetchone()
    return dict(u)

def calc_btc(u):
    bp = prices.get("BTC") or 1
    v = u['btc']+u['sat']/1e8
    for c in ['eth','ltc','doge','sol','xrp','pepe','shib','bonk']:
        v += u[c]*prices.get(c.upper())/bp
    return v

async def give_ach(db, uid, ach_id):
    e = await db.execute("SELECT 1 FROM ach WHERE tid=? AND ach_id=?",(uid,ach_id))
    if await e.fetchone(): return
    await db.execute("INSERT INTO ach (tid,ach_id) VALUES (?,?)",(uid,ach_id))
    info = ACH[ach_id]
    await db.execute("UPDATE users SET sat=sat+? WHERE tid=?",(info['r'],uid))
    await db.commit()
    try: await bot.send_message(uid,f"🏆 <b>Достижение!</b>\n\n{info['n']}\n+{info['r']} сатоши")
    except: pass

async def add_xp(db, uid, xp):
    await db.execute("UPDATE bp SET xp=xp+? WHERE tid=?",(xp,uid))
    bp = await db.execute("SELECT level,xp FROM bp WHERE tid=?",(uid,))
    bp = await bp.fetchone()
    if bp:
        need = bp['level']*100
        if bp['xp']>=need:
            await db.execute("UPDATE bp SET level=level+1,xp=xp-? WHERE tid=?",(need,uid))
            await db.commit()

