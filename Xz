class CryptoPrices:
    def __init__(self):
        self.prices = {
            "BTC": 65000, "ETH": 3400, "LTC": 85, "DOGE": 0.12,
            "SOL": 140, "XRP": 0.55, "PEPE": 0.000007,
            "SHIB": 0.00002, "BONK": 0.000001,
        }
        self.changes = {k: 0.0 for k in self.prices}
        self.last_fetch = 0

    async def fetch(self):
        if time.time() - self.last_fetch < 30:
            return
        try:
            async with aiohttp.ClientSession() as s:
                for coin, sym in {"BTC":"BTCUSDT","ETH":"ETHUSDT","LTC":"LTCUSDT","DOGE":"DOGEUSDT","SOL":"SOLUSDT","XRP":"XRPUSDT"}.items():
                    try:
                        async with s.get(f"https://api.binance.com/api/v3/ticker/price?symbol={sym}", timeout=5) as r:
                            if r.status == 200:
                                d = await r.json()
                                old = self.prices[coin]
                                self.prices[coin] = float(d['price'])
                                self.changes[coin] = ((self.prices[coin]-old)/old*100) if old>0 else 0
                    except: pass
                try:
                    async with s.get("https://api.coingecko.com/api/v3/simple/price?ids=pepe,shiba-inu,bonk&vs_currencies=usd", timeout=5) as r:
                        if r.status == 200:
                            d = await r.json()
                            for coin, key in [("PEPE","pepe"),("SHIB","shiba-inu"),("BONK","bonk")]:
                                if key in d:
                                    old = self.prices[coin]
                                    self.prices[coin] = d[key]['usd']
                                    self.changes[coin] = ((self.prices[coin]-old)/old*100) if old>0 else 0
                except: pass
            self.last_fetch = time.time()
        except: pass

    def get(self, sym):
        return self.prices.get(sym, 0)

