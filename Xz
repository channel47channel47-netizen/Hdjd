@dp.callback_query(F.data == "buy_premium")
async def cmd_buy_premium(callback: CallbackQuery):
    uid = callback.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        u = await get_user(db, uid)
        if u['btc'] < 0.01:
            await callback.answer("Недостаточно BTC! Нужно 0.01", show_alert=True)
            return
        await db.execute("UPDATE users SET btc = btc - 0.01 WHERE telegram_id = ?", (uid,))
        await db.execute("UPDATE bp SET premium = 1 WHERE user_id = ?", (uid,))
        await db.commit()
    
    await callback.answer("Премиум активирован! 👑", show_alert=True)
    await cmd_bp(callback)

