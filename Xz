    await db.execute("INSERT INTO achievements (user_id, ach_id) VALUES (?, ?)", (uid, ach_id))
    info = ACHIEVEMENTS[ach_id]
    await db.execute("UPDATE users SET balance_sat = balance_sat + ? WHERE telegram_id = ?", (info['reward'], uid))
    await db.commit()
    try:
        await bot.send_message(uid, f"🏆 <b>Достижение!</b>\n\n{info['name']}\n{info['desc']}\n+{info['reward']} сатоши")
    except: pass

