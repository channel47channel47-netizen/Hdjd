@dp.callback_query(F.data.startswith("miner_"))
async def buy_miner(callback: CallbackQuery):
    tier = int(callback.data.split("_")[1])
    costs = {1:50, 2:500, 3:5000, 4:50000}
    hashes = {1:10, 2:50, 3:200, 4:1000}
    uid = callback.from_user.id
    
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        u = await get_user(db, uid)
        if u['sat'] < costs[tier]:
            await callback.answer(f"Нужно {costs[tier]} сат!", show_alert=True); return
        
        old_hs = u['mining_hs']
        await db.execute("UPDATE users SET sat = sat - ?, mining_hs = mining_hs + ?, last_mine = ? WHERE tid = ?", (costs[tier], hashes[tier], time.time(), uid))
        await db.commit()
        
        if old_hs==0: await give_ach(db, uid, "first_miner")
        if old_hs+hashes[tier]>=1000: await give_ach(db, uid, "mining_1k")
    
    await callback.answer(f"Куплено! +{hashes[tier]} H/s", show_alert=True)
    await mining(callback)

